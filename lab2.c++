/**
 * @file main.cpp
 * @brief Обработка одномерного динамического массива.
 *
 * Программа создаёт динамический массив целых чисел,
 * находит первый отрицательный элемент и удаляет все элементы,
 * начиная с него. Для работы с динамической памятью используются
 * операторы new[] и delete[].
 *
 * @author Куртнебиев Р.Р.
 * @date 22.09.2026
 */

#include <iostream>
using namespace std;

/**
 * @brief Обрабатывает динамический массив и удаляет все элементы,
 *        начиная с первого отрицательного элемента.
 *
 * Функция ищет первый отрицательный элемент в массиве.
 * Если отрицательный элемент найден, создаётся новый динамический массив,
 * содержащий только элементы до него. Старая память освобождается,
 * а указатель arr получает адрес нового массива.
 *
 * @param arr Ссылка на указатель динамического массива.
 * @param size Размер исходного массива.
 * @return Новый размер массива. Если отрицательных элементов нет,
 *         возвращается исходный размер.
 *
 * @note После выполнения функции указатель arr указывает на новый массив,
 *       если в исходном массиве был найден отрицательный элемент.
 * @warning Переданный массив должен быть выделен с помощью new[].
 */

int process(int*& arr, int size)
{
    int negativeIndex = -1;

    for (int i = 0; i < size; i++)
    {
        if (arr[i] < 0)
        {
            negativeIndex = i;
            break;
        }
    }

    if (negativeIndex == -1)
    {
        return size;
    }

    int newSize = negativeIndex;
    int* newArr = new int[newSize]{};

    for (int i = 0; i < newSize; i++)
    {
        newArr[i] = arr[i];
    }
    delete[] arr;
    arr = newArr;
    return newSize;
}

/**
 * @brief Точка входа в программу.
 *
 * Запрашивает у пользователя размер и элементы динамического массива,
 * выводит исходный массив, обрабатывает его с помощью функции process()
 * и выводит результат.
 *
 * @return 0 При успешном завершении программы.
 *
 * @details В конце работы программы выделенная динамическая память
 *          освобождается с помощью delete[], после чего указатель
 *          arr обнуляется.
 */

int main()
{
    int N;
    cout << "Введите размер массива: ";
    cin >> N;
    int* arr = new int[N]{};
    cout << "Введите элементы массива:" << endl;

    for (int i = 0; i < N; i++)
    {
        cin >> arr[i];
    }

    cout << "Исходный массив: ";

    for (int i = 0; i < N; i++)
    {
        cout << arr[i] << " ";
    }

    cout << endl;
    int newSize = process(arr, N);
    cout << "Результат: ";

    for (int i = 0; i < newSize; i++)
    {
        cout << arr[i] << " ";
    }

    cout << endl;
    delete[] arr;
    arr = nullptr;

    if (arr == nullptr)
    {
        cout << "arr == nullptr" << endl;
        cout << "Указатель безопасно обнулён." << endl;
    }
    return 0;
}